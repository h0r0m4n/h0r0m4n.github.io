<meta property="og:locale" content="en_US">
<meta property="og:type" content="{% if type == 'blog' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{% if title %}{% if client %}{{ client }} {% endif %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.author }}">
<meta property="og:image" content="{{ site.url + '/static/preview.jpg' | url }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.title }}">
{% if type == 'blog' %}
{% if date %}<meta property="article:published_time" content="{{ date | isoDate }}">{% endif %}
<meta property="article:author" content="{{ site.author }}">
{% if category %}<meta property="article:section" content="{{ category }}">{% endif %}
{% endif %}