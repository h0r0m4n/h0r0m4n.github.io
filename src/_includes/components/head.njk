<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{% if description %}{{ description }}{% else %}{{ site.description }}{% endif %}">
<meta name="keywords" content="{{ site.keywords }}">
<meta name="author" content="{{ site.author }}">
{% if type == 'work' or page.url == '/case-studies/' or page.url == '/404.html' %}
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai">
{% else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{% endif %}
{% if type == 'work' or page.url == '/case-studies/' %}
<script>
(function () {
    var hash = '{{ site.password | base64 }}';
    var key = 'FeaturedWork';
    var unlocked = false;
    try {
        var params = new URLSearchParams(window.location.search);
        if (params.get('pwd') === atob(hash)) {
            localStorage.setItem(key, hash);
            params.delete('pwd');
            var cleanUrl = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
            window.history.replaceState({}, '', cleanUrl);
        }
        unlocked = localStorage.getItem(key) === hash;
    } catch (e) {
        unlocked = false;
    }
    if (!unlocked) {
        document.documentElement.style.visibility = 'hidden';
        window.location.replace(window.location.origin + '/');
    }
})();
</script>
<noscript><style>main, article, #works { display: none !important; }</style></noscript>
{% endif %}
<meta name="ai-exclusion" content="true">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="horoman.com">
<meta name="format-detection" content="telephone=no">
<meta name="mobile-web-app-capable" content="yes">
<meta name="pinterest-rich-pin" content="false">

{% include 'components/head-twitter.njk' %}
{% include 'components/head-facebook.njk' %}

<title>{% if title %}{% if client %}{{ client }} {% endif %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>

<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }} — Blog" href="{{ site.url }}/feed.xml">

{% if type == 'blog' %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | dump | safe }},
    "description": {{ (description or site.description) | dump | safe }},
    "image": {{ (site.url + '/static/preview.jpg') | dump | safe }},
    "datePublished": {{ (date | isoDate) | dump | safe }},
    "author": {
        "@type": "Person",
        "name": {{ site.author | dump | safe }},
        "url": {{ site.url | dump | safe }}
    },
    "publisher": {
        "@type": "Person",
        "name": {{ site.author | dump | safe }},
        "url": {{ site.url | dump | safe }}
    },
    {% if category %}"articleSection": {{ category | dump | safe }},{% endif %}
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": {{ (site.url + page.url) | dump | safe }}
    }
}
</script>
{% elif page.url == '/' %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "name": {{ site.author | dump | safe }},
    "url": {{ site.url | dump | safe }},
    "jobTitle": "Staff Product Designer",
    "description": {{ site.description | dump | safe }}{% if social %},
    "sameAs": [{% for item in social %}{{ item.link | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
}
</script>
{% endif %}

<link rel="apple-touch-icon" sizes="180x180" href="{{ site.url + '/apple-touch-icon.png' | url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ site.url + '/favicon-32x32.png' | url }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ site.url + '/favicon-16x16.png' | url }}">
<link rel="manifest" href="{{ site.url + '/site.webmanifest' | url }}">
<link rel="mask-icon" href="{{ site.url + '/safari-pinned-tab.svg' | url }}" color="#fff">

<link rel="preload" href="/static/fonts/colfax-web-regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/klavika-web-display-black.woff2" as="font" type="font/woff2" crossorigin>

<link rel="stylesheet" href="{{ '/css/style.css' | url }}?v={{ site.version }}">

{% if page.url == '/projects/' or type == 'work' or type == 'blog' %}
    <link rel="stylesheet" href="{{ '/css/fancybox.css' | url }}?v={{ site.version }}">
{% endif %}

{% if type == 'work' or type == 'blog' %}
    <link rel="stylesheet" href="{{ '/css/carousel.css' | url }}?v={{ site.version }}">
{% endif %}

{% include 'components/css-vars.njk' %}
